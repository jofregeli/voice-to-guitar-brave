#N canvas 700 100 700 500 12;
#X obj 50 30 adc~ 1;
#X obj 50 70 hip~ 80;
#X obj 50 100 lop~ 2000;
#X obj 50 130 lop~ 2000;
#X obj 50 160 *~ 0.5;
#X obj 50 200 nn~ C:/Users/Usuario/Documents/voice-to-guitar-brave/models/guitar_v6.ts forward;
#X obj 50 250 *~ 30;
#X obj 50 290 dac~;
#X obj 350 200 print nn~-info;
#X msg 350 170 get_methods;
#X text 250 70 hip~ 80: remove DC and rumble (<80 Hz);
#X text 250 100 lop~ 2000 x2: -12 dB/oct rolloff at 2 kHz;
#X text 250 130   removes voice formants which are above 2 kHz;
#X text 250 145   keeps voice fundamentals (80-300 Hz) and harmonics;
#X text 250 160   in guitar's typical range (80-2000 Hz);
#X text 250 195 *~ 0.5: attenuate before model to prevent clipping;
#X text 50 350 GOAL: make voice spectrum look more like guitar;
#X text 50 370 to the encoder. Voice formants (~500-3000 Hz) are;
#X text 50 390 the main thing that makes voice sound NOT like;
#X text 50 410 a guitar to the model.;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 5 1 8 0;
#X connect 6 0 7 0;
#X connect 6 0 7 1;
#X connect 9 0 5 0;
