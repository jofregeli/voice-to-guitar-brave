#N canvas 60 60 950 720 12;
#X text 20 10 Path A: voice -> drumkit via vocal-percussion classifier;
#X text 20 30 SR=44100 Hz \, block 64. Drop PD audio delay below 30 ms for live feel.;
#X text 20 50 Watch env~ on the right. Set "- N" between silence/breath floor and hit peaks.;
#X obj 40 110 adc~ 1;
#X obj 40 150 abs~;
#X obj 40 180 hip~ 200;
#X obj 40 210 env~ 256;
#X obj 40 240 - 40;
#X obj 40 270 > 0;
#X obj 40 300 change;
#X obj 40 330 sel 1;
#X obj 40 360 spigot 1;
#X obj 40 390 del 20;
#X obj 40 420 t b b b b;
#X obj 410 110 nn~ C:/Users/Usuario/Documents/voice-to-guitar-brave/models/vpt_classifier_streaming.ts forward;
#X obj 410 180 snapshot~;
#X obj 510 180 snapshot~;
#X obj 610 180 snapshot~;
#X obj 410 230 pack f f f;
#X obj 410 270 expr ($f2>=$f1)*($f2>$f3) + ($f3>=$f1)*($f3>=$f2)*2;
#X obj 410 310 sel 0 1 2;
#X obj 730 90 table kick_table 16384;
#X obj 730 120 table snare_table 16384;
#X obj 730 150 table hh_table 8192;
#X obj 730 200 loadbang;
#X msg 730 230 read -resize C:/Users/Usuario/Documents/voice-to-guitar-brave/data/samples/kick.wav kick_table \, read -resize C:/Users/Usuario/Documents/voice-to-guitar-brave/data/samples/snare.wav snare_table \, read -resize C:/Users/Usuario/Documents/voice-to-guitar-brave/data/samples/hh.wav hh_table;
#X obj 730 290 soundfiler;
#X obj 410 380 tabplay~ kick_table;
#X obj 530 380 tabplay~ snare_table;
#X obj 650 380 tabplay~ hh_table;
#X obj 410 440 +~;
#X obj 530 480 +~;
#X obj 530 520 *~ 0.7;
#X obj 530 560 dac~;
#X msg 200 480 0;
#X obj 200 510 del 120;
#X msg 200 540 1;
#X obj 250 150 loadbang;
#X obj 250 180 metro 50;
#X obj 250 210 snapshot~;
#X floatatom 250 240 7 0 0 0 env_dB - -;
#X text 320 240 <- live env~ reading. PD scale: ~0=silence \, ~100=full scale.;
#X text 320 260 Watch this while: (1) silent (2) breathing (3) kick (4) snare (5) hh.;
#X text 320 280 Goal: set "- N" so silence < N < every hit peak.;
#X text 320 300 Current N = 40. (Measured: silence=0 \, breath<=10 \, kick=80 \, snare=60 \, hh=70.);
#X text 200 360 spigot blocks new triggers;
#X text 200 375 for 120 ms after each hit.;
#X text 200 420 trigger b b b b: 3 snapshots;
#X text 200 435 + 1 debounce kick-off.;
#X text 100 480 close gate immediately;
#X text 100 540 reopen gate 120 ms later;
#X text 20 600 Output gain on [*~ 0.7]. Increase if quiet \, decrease if clipping.;
#X text 20 620 Classifier always argmaxes - WILL misfire on weak hits. Beatbox clearly.;
#X text 20 640 To see live probs: add [snapshot~] + number boxes to each nn~ outlet.;
