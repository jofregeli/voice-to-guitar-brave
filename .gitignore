# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
venv/
.env
.venv/

# Data — never commit audio files or processed datasets
data/raw/
data/processed/
data/rave_ready/
data/test_preprocessed*/

# LMDB databases (RAVE preprocessing) — preallocated huge/sparse, never commit
*.mdb

# Models — checkpoints can be large, store separately
models/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.suo

# Logs
runs/
lightning_logs/
wandb/
*.log

# Transfer scratch (bundles for moving data/models to another machine)
runs_slim/
*.zip

# RAVE/BRAVE specific
*.ckpt          # Model checkpoints (large)
*.ts            # TorchScript exports (can be very large)

# Audio output files (keep examples/ but not generated audio)
*.wav
*.mp3
*.ogg
# Allow example audio files (committed for the thesis audio-sample links)
!examples/*.wav
!examples/**/*.wav

# Secrets
.env
secrets.yaml
.claude/
.claude-flow/

# LaTeX build artefacts (only the .tex and final .pdf are tracked)
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc

# User calibration audio (personal recordings, not corpus)
data/user_calibration/

# Stray shell-escape leftovers
/$
/$f2
/-
/10
/5$)
